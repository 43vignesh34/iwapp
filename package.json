{
  "name": "iwapp",
  "private": true,
  "description": "ISKCON Whitefield congregation app",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm db:migrate && turbo run dev",
    "dev:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @iwapp/db migrate",
    "db:generate": "pnpm --filter @iwapp/db generate",
    "test:int": "turbo run test:int",
    "seed": "turbo run build --filter=@iwapp/seed^... --output-logs=errors-only && pnpm --filter @iwapp/seed seed",
    "e2e": "turbo run build --filter=@iwapp/e2e^... --output-logs=errors-only && pnpm --filter @iwapp/e2e e2e"
  },
  "prettier": "@iwapp/config/prettier",
  "devDependencies": {
    "@iwapp/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
