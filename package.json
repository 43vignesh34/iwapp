    "format:check": "prettier --check ."
  },
  "prettier": "@iwapp/config/prettier",
  "devDependencies": {
    "@iwapp/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
