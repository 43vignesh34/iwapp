# Copy to .env and fill in. Never commit .env.
# The API validates every variable at startup (apps/api/src/config/env.ts) and refuses to boot
# if anything is missing or malformed.

NODE_ENV=development

# API listen address. Containers (Cloud Run) need HOST=0.0.0.0; locally, 127.0.0.1 keeps the
# API off your network.
PORT=4000
HOST=127.0.0.1

# Postgres. Defaults to the Compose database outside production (apps/api/src/config/env.ts).
# DATABASE_URL=postgres://iwapp:iwapp@localhost:5433/iwapp

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# OpenTelemetry: local defaults live in apps/api/otel.env (committed, non-secret).
# Setting a variable here, or in the real environment, overrides that file.
# Staging and production point these at Grafana Cloud (T10):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceId:token>

# Signs access JWTs. Required in production (32+ characters); a local default is used otherwise.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Test-only sign-in by email (POST /api/v1/auth/test-login). The API refuses to start in
# production with this on. Handy locally: sign in as admin@iwapp.test, leader@iwapp.test,
# circle-leader@iwapp.test or member@iwapp.test (after `pnpm seed`).
AUTH_TEST_MODE=true

# Google OAuth client ID (…apps.googleusercontent.com). Enables Google sign-in; required in
# production. Not a secret: it's also in the web app. Created in docs/deploy (S9).
# GOOGLE_CLIENT_ID=

# Proxies in front of the API: 0 locally. Staging/production set this in S9.
TRUST_PROXY_HOPS=0
