# Copy to .env and fill in. Never commit .env.
# The API validates every variable at startup (apps/api/src/config/env.ts) and refuses to boot
# if anything is missing or malformed.

NODE_ENV=development

# API listen address. Containers (Cloud Run) need HOST=0.0.0.0; locally, 127.0.0.1 keeps the
# API off your network.
PORT=4000
HOST=127.0.0.1
