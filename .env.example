# Copy to .env and fill in. Never commit .env.
# The API validates every variable at startup (apps/api/src/config/env.ts) and refuses to boot
# if anything is missing or malformed.

NODE_ENV=development

# API listen address. Containers (Cloud Run) need HOST=0.0.0.0; locally, 127.0.0.1 keeps the
# API off your network.
PORT=4000
HOST=127.0.0.1

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# OpenTelemetry: local defaults live in apps/api/otel.env (committed, non-secret).
# Setting a variable here, or in the real environment, overrides that file.
# Staging and production point these at Grafana Cloud (T10):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceId:token>
