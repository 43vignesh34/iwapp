{
  "name": "@iwapp/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, SQL migrations and the database client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../.env src/cli/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@iwapp/config": "workspace:*",
    "@types/node": "~24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3"
  }
}
