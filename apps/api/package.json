{
  "name": "@iwapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=otel.env --env-file-if-exists=../../.env --import @opentelemetry/auto-instrumentations-node/register --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @opentelemetry/auto-instrumentations-node/register dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@iwapp/db": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iwapp/config": "workspace:*",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "~24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
