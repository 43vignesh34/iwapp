    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iwapp/config": "workspace:*",
    "@types/node": "~24.19.2",
    "eslint": "^10.14.0",
    "openapi-types": "^12.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
