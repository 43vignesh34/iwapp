# OpenTelemetry settings for local development (non-secret; committed on purpose).
# The OTel SDK reads these standard variables itself: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# Real environment variables win over this file, so Cloud Run can point at Grafana Cloud instead.
OTEL_SERVICE_NAME=iwapp-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Only what we need: incoming/outgoing HTTP, Postgres queries, and Pino (adds trace_id to logs and ships them).
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,pg,pino
# Grafana LGTM container from docker-compose.yml (OTLP over HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
